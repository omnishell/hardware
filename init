__device__() {
    __device__.__help__() {
        cat >&2 <<'EOF'
ABOUT:
    omni device manager

USAGE:
    device <module> <command> [args]

MODULES:
    monitor     displays and positions (xrandr, or sysfs /sys/class/drm)
    network     all network devices (nmcli, or sysfs /sys/class/net)
    wifi        wireless networks (nmcli)
    bluetooth   bluetooth devices (bluetoothctl)
    usb         usb devices (lsusb, or sysfs /sys/bus/usb/devices)
    pci         pci devices (lspci, or sysfs /sys/bus/pci/devices)
    audio       audio sinks & sources (pactl, or amixer)
    power       power devices & battery status (sysfs)
    light       backlight devices (sysfs, or xbacklight)
    input       input devices (xinput, or sysfs /sys/class/input)
    camera      video capture devices (v4l2-ctl, or /dev/video*, or sysfs)
    ls          list all devices across modules

MONITOR COMMANDS:
    monitor ls [-a|--all]                list connected monitors
    monitor ls -e|--enabled              list enabled monitors only
    monitor ls -d|--disabled             list disabled monitors (connected-off + disconnected)
    monitor enable <mon> [--res WxH]     activate a monitor (preferred resolution with --res)
    monitor disable <mon>                deactivate a monitor
    monitor move <mon> -l|--left [<ref>]   position <mon> to the left of <ref> (default: primary)
    monitor move <mon> -r|--right [<ref>]  position <mon> to the right of <ref> (default: primary)
    monitor move <mon> -a|--above [<ref>]  position <mon> above <ref> (default: primary)
    monitor move <mon> -b|--below [<ref>]  position <mon> below <ref> (default: primary)
    monitor move <mon> -s|--same-as <ref>  position <mon> on the same display as <ref>

NETWORK COMMANDS:
    network ls                           list all network devices (type, state)

WIFI COMMANDS:
    wifi ls                              scan and list nearby networks
    wifi ls -r|--registered              list registered wifi profiles
    wifi set|new <name> --id <id>        register a wifi profile (WPA-PSK with --pass)
    wifi connect <name>                  connect to a registered wifi profile
    wifi disconnect <name>               disconnect a wifi profile
    wifi rm <name>                       delete a registered wifi profile

BLUETOOTH COMMANDS:
    bluetooth ls [-p|--paired]           list bluetooth devices
    bluetooth connect <addr>             connect to a bluetooth device
    bluetooth disconnect <addr>          disconnect a bluetooth device
    bluetooth remove <addr>              remove a bluetooth device

USB COMMANDS:
    usb ls                               list usb devices (lsusb, or sysfs)

PCI COMMANDS:
    pci ls                               list pci devices (lspci, or sysfs)

AUDIO COMMANDS:
    audio ls                             list audio sinks and sources
    audio mute                           toggle mute of the default sink
    audio unmute                         set the default sink to unmuted
    audio set <vol>                      set the default sink volume as a percent

POWER COMMANDS:
    power ls                             list power devices with status and capacity

LIGHT COMMANDS:
    light ls                             list backlight devices with current and max brightness
    light set <pct> [dev]                set backlight brightness as a percent of max

INPUT COMMANDS:
    input ls                             list input devices
    input disable <id>                   disable an input device
    input enable <id>                    enable an input device

CAMERA COMMANDS:
    camera ls                            list video capture devices
EOF
    }

    __device__.need() {
        command -v "$1" >/dev/null 2>&1 && return 0
        echo "device: '$1' is required for this command" >&2
        return 1
    }

    __device__.has() {
        command -v "$1" >/dev/null 2>&1
    }

    # --- MONITOR: displays (xrandr, or sysfs /sys/class/drm) ---

    __device__.monitor.ls() {
        if __device__.has xrandr; then
            __device__.monitor.ls_xrandr "$@"
        else
            __device__.monitor.ls_sysfs "$@"
        fi
    }

    __device__.monitor.ls_xrandr() {
        local show_all=0 show_enabled=0 show_disabled=0 line mon is_enabled
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -a|--all) show_all=1 ;;
                -e|--enabled) show_enabled=1 ;;
                -d|--disabled) show_disabled=1 ;;
            esac
            shift
        done

        __device__.need xrandr || return 1

        while read -r line; do
            if [[ "$line" == *" connected "* ]]; then
                mon="${line%% *}"
                is_enabled=0
                [[ "$line" == *" primary "* || "$line" =~ \ [0-9]+x[0-9]+\+ ]] && is_enabled=1

                if (( show_all )); then
                    echo "$mon"
                elif (( show_enabled )); then
                    (( is_enabled )) && echo "$mon"
                elif (( show_disabled )); then
                    (( ! is_enabled )) && echo "$mon"
                else
                    echo "$mon"
                fi
            elif [[ "$line" == *" disconnected "* ]] && (( show_all || show_disabled )); then
                echo "${line%% *}"
            fi
        done < <(xrandr)
    }

    __device__.monitor.ls_sysfs() {
        local dir name status
        for dir in /sys/class/drm/card*-*; do
            [[ -d "$dir" ]] || continue
            status=$(cat "$dir/status" 2>/dev/null)
            [[ "$status" == "connected" ]] || continue
            name="${dir##*/}"
            name="${name#card*-}"
            [[ -n "$name" ]] && echo "$name"
        done
    }

    __device__.monitor.enable() {
        local mon="${1:-}" mode=""
        shift 2>/dev/null
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --res) mode="--mode $2"; shift ;;
            esac
            shift
        done

        if [[ -z "$mon" ]]; then
            echo "device monitor enable: missing monitor" >&2
            return 1
        fi

        if __device__.has xrandr; then
            if [[ -n "$mode" ]]; then
                xrandr --output "$mon" $mode
            else
                xrandr --output "$mon" --auto
            fi
        else
            __device__.monitor.enable_sysfs "$mon"
        fi
    }

    __device__.monitor.enable_sysfs() {
        local mon="$1" dir=""
        for dir in /sys/class/drm/card*-$mon; do
            [[ -d "$dir" ]] && break
            dir=""
        done
        if [[ -z "$dir" ]]; then
            echo "device monitor enable: '$mon' not found via sysfs" >&2
            return 1
        fi
        if echo enabled > "$dir/status" 2>/dev/null || echo 1 > "$dir/enabled" 2>/dev/null; then
            return 0
        fi
        echo "device monitor enable: cannot enable '$mon' via sysfs (write denied?)" >&2
        return 1
    }

    __device__.monitor.disable() {
        local mon="${1:-}" dir=""
        if [[ -z "$mon" ]]; then
            echo "device monitor disable: missing monitor" >&2
            return 1
        fi
        if __device__.has xrandr; then
            xrandr --output "$mon" --off
            return $?
        fi
        for dir in /sys/class/drm/card*-$mon; do
            [[ -d "$dir" ]] && break
            dir=""
        done
        if [[ -z "$dir" ]]; then
            echo "device monitor disable: '$mon' not found via sysfs" >&2
            return 1
        fi
        if echo disabled > "$dir/status" 2>/dev/null || echo 0 > "$dir/enabled" 2>/dev/null; then
            return 0
        fi
        echo "device monitor disable: cannot disable '$mon' via sysfs (write denied?)" >&2
        return 1
    }

    __device__.monitor.move() {
        local mon="${1:-}" pos_flag="" pos_ref="" line
        shift 2>/dev/null
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -l|--left)    [[ -z "$pos_flag" ]] && { pos_flag="--left-of";  pos_ref="${2:-}"; } ;;
                -r|--right)   [[ -z "$pos_flag" ]] && { pos_flag="--right-of"; pos_ref="${2:-}"; } ;;
                -a|--above)   [[ -z "$pos_flag" ]] && { pos_flag="--above";    pos_ref="${2:-}"; } ;;
                -b|--below)   [[ -z "$pos_flag" ]] && { pos_flag="--below";    pos_ref="${2:-}"; } ;;
                -s|--same-as) [[ -z "$pos_flag" ]] && { pos_flag="--same-as";  pos_ref="${2:-}"; } ;;
            esac
            shift 2 2>/dev/null || shift
        done

        if [[ -z "$mon" || -z "$pos_flag" ]]; then
            echo "device monitor move: missing monitor or direction" >&2
            return 1
        fi

        __device__.need xrandr || return 1

        if [[ -z "$pos_ref" ]]; then
            # default reference: the primary monitor
            while read -r line; do
                if [[ "$line" == *" connected primary "* ]]; then
                    pos_ref="${line%% *}"
                    break
                fi
            done < <(xrandr)
        fi

        if [[ -z "$pos_ref" ]]; then
            echo "device monitor move: no reference monitor given and none is primary" >&2
            return 1
        fi

        xrandr --output "$mon" --auto "$pos_flag" "$pos_ref"
    }

    __device__.monitor() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.monitor.ls "$@" ;;
            enable) __device__.monitor.enable "$@" ;;
            disable) __device__.monitor.disable "$@" ;;
            move|mv) __device__.monitor.move "$@" ;;
            "") echo "device monitor: missing command (ls|enable|disable|move)" >&2; return 1 ;;
            *) echo "device monitor: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- NETWORK: all network devices (nmcli, or sysfs /sys/class/net) ---

    __device__.network.ls() {
        if __device__.has nmcli; then
            nmcli -t -f DEVICE,TYPE,STATE dev status
        else
            __device__.network.ls_sysfs
        fi
    }

    __device__.network.ls_sysfs() {
        local d state
        for d in /sys/class/net/*; do
            [[ -d "$d" ]] || continue
            state=$(cat "$d/operstate" 2>/dev/null)
            printf '%-12s %s\n' "${d##*/}" "${state:-unknown}"
        done
    }

    __device__.network() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.network.ls "$@" ;;
            "") echo "device network: missing command (ls)" >&2; return 1 ;;
            *) echo "device network: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- WIFI: wireless networks (nmcli) ---

    __device__.wifi.ls() {
        local show_registered=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -r|--registered) show_registered=1 ;;
            esac
            shift
        done

        __device__.need nmcli || return 1

        if (( show_registered )); then
            local name uuid type
            while IFS=: read -r name uuid type _; do
                if [[ "$type" == "802-11-wireless" ]]; then
                    echo "$name"
                fi
            done < <(nmcli -t -f NAME,UUID,TYPE connection show)
        else
            nmcli --color=auto dev wifi list
        fi
    }

    __device__.wifi.set() {
        local name="" id="" pass=""
        if [[ "${1:-}" != -* ]]; then
            name="$1"
            shift 2>/dev/null
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --id) id="${2:-}"; shift ;;
                --pass) pass="${2:-}"; shift ;;
                *) [[ -z "$name" ]] && name="$1" ;;
            esac
            shift
        done

        __device__.need nmcli || return 1
        if [[ -z "$name" || -z "$id" ]]; then
            echo "device wifi set: missing profile name or --id <ssid>" >&2
            return 1
        fi

        nmcli connection add type wifi con-name "$name" ssid "$id" >/dev/null || return 1
        if [[ -n "$pass" ]]; then
            nmcli connection modify "$name" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pass" >/dev/null
        fi
    }

    __device__.wifi.connect() {
        local name="${1:-}"
        [[ -z "$name" ]] && return 1
        __device__.need nmcli || return 1
        nmcli connection up "$name"
    }

    __device__.wifi.disconnect() {
        local name="${1:-}"
        [[ -z "$name" ]] && return 1
        __device__.need nmcli || return 1
        nmcli connection down "$name"
    }

    __device__.wifi.rm() {
        local name="${1:-}"
        [[ -z "$name" ]] && return 1
        __device__.need nmcli || return 1
        nmcli connection delete "$name"
    }

    __device__.wifi() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.wifi.ls "$@" ;;
            set|new) __device__.wifi.set "$@" ;;
            connect) __device__.wifi.connect "$@" ;;
            disconnect) __device__.wifi.disconnect "$@" ;;
            rm) __device__.wifi.rm "$@" ;;
            "") echo "device wifi: missing command (ls|set|new|connect|disconnect|rm)" >&2; return 1 ;;
            *) echo "device wifi: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- BLUETOOTH: bluetooth devices (bluetoothctl) ---

    __device__.bluetooth.ls() {
        local show_paired=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -p|--paired) show_paired=1 ;;
            esac
            shift
        done
        __device__.need bluetoothctl || return 1
        if (( show_paired )); then
            # bluetoothctl 'devices' accepts a property filter; 'Paired' lists paired devices
            bluetoothctl devices Paired
        else
            bluetoothctl devices
        fi
    }

    __device__.bluetooth.connect() {
        local addr="${1:-}"
        [[ -z "$addr" ]] && return 1
        __device__.need bluetoothctl || return 1
        bluetoothctl connect "$addr"
    }

    __device__.bluetooth.disconnect() {
        local addr="${1:-}"
        [[ -z "$addr" ]] && return 1
        __device__.need bluetoothctl || return 1
        bluetoothctl disconnect "$addr"
    }

    __device__.bluetooth.remove() {
        local addr="${1:-}"
        [[ -z "$addr" ]] && return 1
        __device__.need bluetoothctl || return 1
        bluetoothctl remove "$addr"
    }

    __device__.bluetooth() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.bluetooth.ls "$@" ;;
            connect) __device__.bluetooth.connect "$@" ;;
            disconnect) __device__.bluetooth.disconnect "$@" ;;
            remove|rm) __device__.bluetooth.remove "$@" ;;
            "") echo "device bluetooth: missing command (ls|connect|disconnect|remove)" >&2; return 1 ;;
            *) echo "device bluetooth: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- USB: usb devices (lsusb, or sysfs /sys/bus/usb/devices) ---

    __device__.usb.ls() {
        if __device__.has lsusb; then
            lsusb
        else
            __device__.usb.ls_sysfs
        fi
    }

    __device__.usb.ls_sysfs() {
        local d vendor product name
        for d in /sys/bus/usb/devices/*; do
            [[ -d "$d" ]] || continue
            vendor=$(cat "$d/idVendor" 2>/dev/null)
            [[ -n "$vendor" ]] || continue
            product=$(cat "$d/idProduct" 2>/dev/null)
            name=$(cat "$d/product" 2>/dev/null)
            if [[ -n "$name" ]]; then
                printf '%s:%s  %s\n' "$vendor" "${product:-?}" "$name"
            else
                printf '%s:%s\n' "$vendor" "${product:-?}"
            fi
        done
    }

    __device__.usb() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.usb.ls "$@" ;;
            "") echo "device usb: missing command (ls)" >&2; return 1 ;;
            *) echo "device usb: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- PCI: pci devices (lspci, or sysfs /sys/bus/pci/devices) ---

    __device__.pci.ls() {
        if __device__.has lspci; then
            lspci -nnk
        else
            __device__.pci.ls_sysfs
        fi
    }

    __device__.pci.ls_sysfs() {
        local d addr vendor device class driver
        for d in /sys/bus/pci/devices/*; do
            [[ -d "$d" ]] || continue
            addr="${d##*/}"
            vendor=$(cat "$d/vendor" 2>/dev/null)
            device=$(cat "$d/device" 2>/dev/null)
            class=$(cat "$d/class" 2>/dev/null)
            driver=$(readlink "$d/driver" 2>/dev/null); driver="${driver##*/}"
            printf '%s  class=%s vendor=%s:%s driver=%s\n' \
                "$addr" "${class:-?}" "${vendor:-?}" "${device:-?}" "${driver:-none}"
        done
    }

    __device__.pci() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.pci.ls "$@" ;;
            "") echo "device pci: missing command (ls)" >&2; return 1 ;;
            *) echo "device pci: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- AUDIO: audio sinks & sources (pactl, or amixer) ---

    __device__.audio.ls() {
        if __device__.has pactl; then
            echo "sinks:"
            pactl list sinks short
            echo "sources:"
            pactl list sources short
        elif __device__.has amixer; then
            __device__.audio.ls_amixer
        fi
    }

    __device__.audio.ls_amixer() {
        amixer scontents 2>/dev/null | grep -E "^Simple mixer control" | awk -F"'" '{print $2}'
    }

    __device__.audio.mute() {
        if __device__.has pactl; then
            __device__.need pactl || return 1
            pactl set-sink-mute @DEFAULT_SINK@ toggle
        elif __device__.has amixer; then
            __device__.need amixer || return 1
            amixer set 'Master' toggle
        fi
    }

    __device__.audio.unmute() {
        if __device__.has pactl; then
            __device__.need pactl || return 1
            pactl set-sink-mute @DEFAULT_SINK@ no
        elif __device__.has amixer; then
            __device__.need amixer || return 1
            amixer set 'Master' on
        fi
    }

    __device__.audio.set() {
        local vol="${1:-}"
        [[ -z "$vol" ]] && return 1
        [[ "$vol" =~ ^-?[0-9]+%?$ ]] || { echo "device audio set: invalid volume '$vol'" >&2; return 1; }
        vol="${vol%"%"}"
        if __device__.has pactl; then
            __device__.need pactl || return 1
            pactl set-sink-volume @DEFAULT_SINK@ "${vol}%"
        elif __device__.has amixer; then
            __device__.need amixer || return 1
            amixer set 'Master' "${vol}%"
        fi
    }

    __device__.audio() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.audio.ls "$@" ;;
            mute) __device__.audio.mute "$@" ;;
            unmute) __device__.audio.unmute "$@" ;;
            set) __device__.audio.set "$@" ;;
            "") echo "device audio: missing command (ls|mute|unmute|set)" >&2; return 1 ;;
            *) echo "device audio: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- POWER: power devices & batteries (sysfs) ---

    __device__.power.ls() {
        local found=0 dir name status capacity
        for dir in /sys/class/power_supply/*; do
            [[ -d "$dir" ]] || continue
            found=1
            name="${dir##*/}"
            status=$([[ -f "$dir/status" ]] && cat "$dir/status" 2>/dev/null)
            capacity=$([[ -f "$dir/capacity" ]] && cat "$dir/capacity" 2>/dev/null)
            if [[ -n "$capacity" ]]; then
                printf '%-20s %-12s capacity=%s%%\n' "$name" "${status:-unknown}" "$capacity"
            else
                printf '%-20s %-12s capacity=n/a\n' "$name" "${status:-unknown}"
            fi
        done
        (( found )) || { echo "device power: no power devices found" >&2; return 1; }
    }

    __device__.power() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.power.ls "$@" ;;
            "") echo "device power: missing command (ls)" >&2; return 1 ;;
            *) echo "device power: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- LIGHT: backlight (sysfs, or xbacklight) ---

    __device__.light.ls() {
        local found=0 dir name cur max pct
        for dir in /sys/class/backlight/*; do
            [[ -d "$dir" ]] || continue
            found=1
            name="${dir##*/}"
            cur=$([[ -f "$dir/brightness" ]] && cat "$dir/brightness" 2>/dev/null)
            max=$([[ -f "$dir/max_brightness" ]] && cat "$dir/max_brightness" 2>/dev/null)
            if [[ -n "$max" && "$max" != 0 && -n "$cur" ]]; then
                pct=$(( cur * 100 / max ))
            else
                pct=0
            fi
            printf '%-20s current=%-6s max=%-6s brightness=%s%%\n' "$name" "${cur:-n/a}" "${max:-n/a}" "$pct"
        done
        if (( ! found )); then
            if __device__.has xbacklight; then
                local pct
                pct=$(xbacklight -get 2>/dev/null)
                [[ -n "$pct" ]] && printf 'xbacklight  %s%%\n' "$pct"
                return 0
            fi
            echo "device light: no backlight device found" >&2
            return 1
        fi
    }

    __device__.light.set() {
        local pct="${1:-}" dev="${2:-}" dirs=() dir name="" max val
        [[ -z "$pct" ]] && return 1
        [[ "$pct" =~ ^[0-9]+$ ]] || { echo "device light: invalid percent '$pct'" >&2; return 1; }
        (( pct > 100 )) && pct=100

        for dir in /sys/class/backlight/*; do
            [[ -d "$dir" ]] && dirs+=("$dir")
        done

        if [[ -n "$dev" ]]; then
            dir=""
            for d in "${dirs[@]}"; do
                [[ "${d##*/}" == "$dev" ]] && dir="$d"
            done
            [[ -n "$dir" ]] || { echo "device light: no backlight device named '$dev'" >&2; return 1; }
        elif [[ -n "${dirs[0]:-}" ]]; then
            dir="${dirs[0]}"
        fi

        if [[ -n "$dir" ]]; then
            name="${dir##*/}"
            max=$(cat "$dir/max_brightness" 2>/dev/null)
            [[ -n "$max" && "$max" != 0 ]] || { echo "device light: '$name' has no writable brightness" >&2; return 1; }
            val=$(( pct * max / 100 ))
            (( val > max )) && val=$max
            if echo "$val" > "$dir/brightness" 2>/dev/null; then
                printf 'device light: set %s brightness to %s%% (%s/%s)\n' "$name" "$pct" "$val" "$max"
                return 0
            fi
            # sysfs write not permitted: fall back to the xbacklight tool
            if __device__.has xbacklight; then
                xbacklight -set "$pct"
                return $?
            fi
            echo "device light: cannot set brightness of '$name' (check permissions)" >&2
            return 1
        fi

        # no sysfs backlights: try the xbacklight tool
        if __device__.has xbacklight; then
            xbacklight -set "$pct"
            return $?
        fi
        echo "device light: no backlight device found" >&2
        return 1
    }

    __device__.light() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.light.ls "$@" ;;
            set) __device__.light.set "$@" ;;
            "") echo "device light: missing command (ls|set)" >&2; return 1 ;;
            *) echo "device light: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- INPUT: input devices (xinput, or sysfs /sys/class/input) ---

    __device__.input.ls() {
        if __device__.has xinput; then
            xinput list
        else
            __device__.input.ls_sysfs
        fi
    }

    __device__.input.ls_sysfs() {
        local d name
        for d in /sys/class/input/*; do
            [[ -e "$d" ]] || continue
            name=$(cat "$d/name" 2>/dev/null)
            if [[ -n "$name" ]]; then
                printf '%s  %s\n' "${d##*/}" "$name"
            else
                printf '%s\n' "${d##*/}"
            fi
        done
    }

    __device__.input.disable() {
        local id="${1:-}"
        [[ -z "$id" ]] && return 1
        __device__.need xinput || return 1
        xinput --disable "$id"
    }

    __device__.input.enable() {
        local id="${1:-}"
        [[ -z "$id" ]] && return 1
        __device__.need xinput || return 1
        xinput --enable "$id"
    }

    __device__.input() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.input.ls "$@" ;;
            disable) __device__.input.disable "$@" ;;
            enable) __device__.input.enable "$@" ;;
            "") echo "device input: missing command (ls|disable|enable)" >&2; return 1 ;;
            *) echo "device input: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- CAMERA: video capture devices (v4l2-ctl, or /dev/video*, or sysfs) ---

    __device__.camera.ls() {
        if __device__.has v4l2-ctl; then
            v4l2-ctl --list-devices
            return 0
        fi
        local out
        out=$(ls /dev/video* 2>/dev/null)
        if [[ -n "$out" ]]; then
            printf '%s\n' "$out"
            return 0
        fi
        out=$(ls /sys/class/video4linux/* 2>/dev/null)
        if [[ -n "$out" ]]; then
            printf '%s\n' "$out"
            return 0
        fi
        echo "device camera: no video capture devices found" >&2
        return 1
    }

    __device__.camera() {
        local cmd="${1:-}"
        shift 2>/dev/null
        case "$cmd" in
            ls) __device__.camera.ls "$@" ;;
            "") echo "device camera: missing command (ls)" >&2; return 1 ;;
            *) echo "device camera: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    # --- OVERVIEW: list all devices across modules ---

    __device__.ls() {
        local mod out
        for mod in monitor network wifi bluetooth usb pci audio power light input camera; do
            out=$(__device__."$mod".ls 2>/dev/null) || continue
            [[ -n "$out" ]] || continue
            printf '== %s ==\n%s\n' "$mod" "$out"
        done
    }

    # --- Compatibility aliases for the previous short names ---

    __device__.mon() { __device__.monitor "$@"; }
    __device__.net() { __device__.network "$@"; }
    __device__.bt() { __device__.bluetooth "$@"; }
    __device__.cam() { __device__.camera "$@"; }

    device() {
        local cmd="${1:-}"
        if [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]]; then
            __device__.__help__
            return 0
        fi
        shift 2>/dev/null
        case "$cmd" in
            monitor|mon) __device__.monitor "$@" ;;
            network|net) __device__.network "$@" ;;
            wifi) __device__.wifi "$@" ;;
            bluetooth|bt) __device__.bluetooth "$@" ;;
            usb) __device__.usb "$@" ;;
            pci) __device__.pci "$@" ;;
            audio) __device__.audio "$@" ;;
            power) __device__.power "$@" ;;
            light) __device__.light "$@" ;;
            input) __device__.input "$@" ;;
            camera|cam) __device__.camera "$@" ;;
            ls) __device__.ls ;;
            *) echo "device: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    __device__.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" base_cmd="${COMP_WORDS[1]:-}" sub_cmd="${COMP_WORDS[2]:-}"

        _get_input_ids() {
            xinput list 2>/dev/null | awk 'match($0, /id=[0-9]+/) { print substr($0, RSTART + 3, RLENGTH - 3) }'
        }

        if [[ "${COMP_CWORD}" == 1 ]]; then
            COMPREPLY=( $(compgen -W "monitor network wifi bluetooth usb pci audio power light input camera ls --help -h" -- "$cur") )
            return 0
        fi

        _get_mons() {
            if __device__.has xrandr; then
                local line mons=""
                while read -r line; do
                    [[ "$line" == *" connected "* ]] && mons+="${line%% *} "
                done < <(xrandr)
                echo "$mons"
            else
                local d name status
                for d in /sys/class/drm/card*-*; do
                    [[ -d "$d" ]] || continue
                    status=$(cat "$d/status" 2>/dev/null)
                    [[ "$status" == "connected" ]] || continue
                    name="${d##*/}"; name="${name#card*-}"
                    [[ -n "$name" ]] && echo "$name "
                done
            fi
        }

        if [[ "$base_cmd" == "monitor" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls enable disable move" -- "$cur") )
                return 0
            fi
            if [[ "$sub_cmd" == "ls" && "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-a --all -e --enabled -d --disabled" -- "$cur") )
            elif [[ "$sub_cmd" == "move" ]]; then
                local dir_flags="-l --left -r --right -a --above -b --below -s --same-as"
                if [[ "${COMP_CWORD}" == 3 || "${COMP_CWORD}" == 4 ]]; then
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=( $(compgen -W "$dir_flags" -- "$cur") )
                    else
                        COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
                    fi
                elif [[ "${COMP_CWORD}" == 5 ]]; then
                    case "$prev" in
                        -l|--left|-r|--right|-a|--above|-b|--below|-s|--same-as)
                            COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
                            ;;
                    esac
                fi
            elif [[ "$sub_cmd" == "enable" || "$sub_cmd" == "disable" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
            fi
        elif [[ "$base_cmd" == "network" || "$base_cmd" == "usb" || "$base_cmd" == "pci" || "$base_cmd" == "power" || "$base_cmd" == "camera" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls" -- "$cur") )
            fi
        elif [[ "$base_cmd" == "wifi" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls set new connect disconnect rm" -- "$cur") )
                return 0
            fi

            _get_wifi_registered() {
                local name uuid type
                while IFS=: read -r name uuid type _; do
                    [[ "$type" == "802-11-wireless" && -n "$name" ]] && echo "\"$name\""
                done < <(nmcli -t -f NAME,UUID,TYPE connection show 2>/dev/null)
            }

            if [[ "$sub_cmd" == "connect" || "$sub_cmd" == "disconnect" || "$sub_cmd" == "rm" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_wifi_registered)" -- "$cur") )
            elif [[ "$sub_cmd" == "ls" && "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-r --registered" -- "$cur") )
            elif [[ "$sub_cmd" == "set" || "$sub_cmd" == "new" ]]; then
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "--id --pass" -- "$cur") )
                fi
            fi
        elif [[ "$base_cmd" == "bluetooth" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls connect disconnect remove" -- "$cur") )
                return 0
            fi

            _get_bt_addrs() {
                bluetoothctl devices 2>/dev/null | awk '$1 == "Device" { print $2 }'
            }

            if [[ "$sub_cmd" == "connect" || "$sub_cmd" == "disconnect" || "$sub_cmd" == "remove" || "$sub_cmd" == "rm" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_bt_addrs)" -- "$cur") )
            elif [[ "$sub_cmd" == "ls" && "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-p --paired" -- "$cur") )
            fi
        elif [[ "$base_cmd" == "audio" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls mute unmute set" -- "$cur") )
            fi
        elif [[ "$base_cmd" == "light" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls set" -- "$cur") )
            elif [[ "$sub_cmd" == "set" ]]; then
                COMPREPLY=( $(compgen -W "$(ls /sys/class/backlight 2>/dev/null)" -- "$cur") )
            fi
        elif [[ "$base_cmd" == "input" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls disable enable" -- "$cur") )
            elif [[ "$sub_cmd" == "disable" || "$sub_cmd" == "enable" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_input_ids)" -- "$cur") )
            fi
        fi
    }

    __device__.__init__() {
        __compl device
    }
}
